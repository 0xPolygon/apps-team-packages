{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    // Override the source-condition resolution inherited from tsconfig.json.
    // Build-time output must reference workspace deps via their published
    // dist/.d.ts (Node default resolution), not their src/. Currently zero
    // diff in emitted output; defends against future drift.
    "customConditions": [],
    // Library consumed by bundlers (Vite, Next.js, Turbopack) — override
    // the node24 application defaults so the emitted JS is bundler-friendly.
    // JSX + DOM lib are inherited from tsconfig.json.
    "module": "preserve",
    "moduleResolution": "bundler"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
