{
  "extends": ["@tsconfig/node24", "@tsconfig/node-ts"],
  "compilerOptions": {
    "noEmit": true,
    "noUncheckedSideEffectImports": true,
    "customConditions": ["@polygonlabs/source"],
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ESNext"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "vitest.config.ts",
    "eslint.config.js"
  ]
}
