{
  "name": "@polygonlabs/verror",
  "version": "0.2.0",
  "description": "TypeScript-first, browser-friendly VError-inspired error handling library",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xPolygon/apps-team-packages.git",
    "directory": "packages/verror"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "clean": "rm -rf node_modules dist *.tsbuildinfo",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@polygonlabs/apps-team-lint": "^1.0.0",
    "@tsconfig/node-ts": "^23.0.0",
    "@tsconfig/node24": "^24.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.3"
  }
}
