{
  "name": "@polygonlabs/express",
  "version": "4.1.1",
  "description": "Shared Express middleware for Polygon Apps Team services: per-request child logger, global error handler with ethers fetch-error sanitisation, and a uniform 404 handler.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xPolygon/apps-team-packages.git",
    "directory": "packages/express"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./registry": {
        "types": "./dist/registry/index.d.ts",
        "import": "./dist/registry/index.js"
      }
    }
  },
  "exports": {
    ".": {
      "@polygonlabs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./registry": {
      "@polygonlabs/source": "./src/registry/index.ts",
      "types": "./dist/registry/index.d.ts",
      "import": "./dist/registry/index.js"
    }
  },
  "files": [
    "dist",
    "MIGRATION.md"
  ],
  "scripts": {
    "build": "pnpm run typecheck && tsc -b tsconfig.lib.json",
    "build:clean": "pnpm run typecheck && rm -rf dist out-tsc *.tsbuildinfo && tsc -b tsconfig.lib.json",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint .",
    "clean": "rm -rf node_modules dist out-tsc *.tsbuildinfo",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@polygonlabs/apps-team-lint": "workspace:*",
    "@polygonlabs/logger": "workspace:*",
    "@polygonlabs/openapi-registry": "workspace:*",
    "@polygonlabs/verror": "workspace:*",
    "@polygonlabs/zod-codecs": "workspace:*",
    "@tsconfig/node-ts": "^23.0.0",
    "@tsconfig/node24": "^24.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^10.0.0",
    "ethers": "^6.16.0",
    "express": "^5.0.0",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.3",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@asteasolutions/zod-to-openapi": "^8.0.0",
    "@polygonlabs/logger": "^3.0.1",
    "@polygonlabs/openapi-registry": "^2.1.2",
    "@polygonlabs/verror": "^1.1.1",
    "express": ">=5",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@asteasolutions/zod-to-openapi": {
      "optional": true
    },
    "@polygonlabs/openapi-registry": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
