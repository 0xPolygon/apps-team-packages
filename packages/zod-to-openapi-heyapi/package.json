{
  "name": "@polygonlabs/zod-to-openapi-heyapi",
  "version": "2.1.0",
  "description": "hey-api/openapi-ts plugin that sources Zod schemas (with codecs) from a zod-to-openapi OpenAPIRegistry instead of regenerating them from the spec — so generated clients use your actual Zod runtime types.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xPolygon/apps-team-packages.git",
    "directory": "packages/zod-to-openapi-heyapi"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./errors": {
        "types": "./dist/errors.d.ts",
        "import": "./dist/errors.js"
      }
    }
  },
  "exports": {
    ".": {
      "@polygonlabs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./errors": {
      "@polygonlabs/source": "./src/errors.ts",
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    }
  },
  "imports": {
    "#test-fixtures/schemas": "./test/fixtures/schemas.ts"
  },
  "files": [
    "dist",
    "MIGRATION.md"
  ],
  "scripts": {
    "build": "pnpm run typecheck && tsc -b tsconfig.lib.json",
    "build:clean": "pnpm run typecheck && rm -rf dist out-tsc *.tsbuildinfo && tsc -b tsconfig.lib.json",
    "codegen": "node --conditions @polygonlabs/source test/codegen.ts",
    "codegen-drift": "pnpm run codegen && git diff --exit-code -- test/__generated__",
    "typecheck": "tsc -b",
    "test": "playwright install chromium && vitest run",
    "lint": "eslint .",
    "clean": "rm -rf node_modules dist out-tsc *.tsbuildinfo",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@asteasolutions/zod-to-openapi": "^8.0.0",
    "@hey-api/openapi-ts": ">=0.97.3",
    "@tanstack/react-query": "^5.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    }
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@hey-api/openapi-ts": "^0.97.3",
    "@playwright/browser-chromium": "1.60.0",
    "@polygonlabs/apps-team-lint": "workspace:*",
    "@polygonlabs/zod-codecs": "workspace:*",
    "@tanstack/react-query": "^5.100.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@tsconfig/node-ts": "^23.0.0",
    "@tsconfig/node24": "^24.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/browser": "^3.2.4",
    "eslint": "^10.0.0",
    "msw": "^2.7.0",
    "playwright": "1.60.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.3",
    "zod": "^4.3.6"
  },
  "msw": {
    "workerDirectory": [
      "test/__msw__"
    ]
  }
}
