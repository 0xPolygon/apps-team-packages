{
  "name": "@polygonlabs/apps-team-lint",
  "version": "2.0.2",
  "description": "Shared lint configurations for Polygon Typescript (Apps Team)",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xPolygon/apps-team-packages.git",
    "directory": "packages/apps-team-lint"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./commitlint": {
      "types": "./src/commitlint.ts",
      "default": "./src/commitlint.ts"
    },
    "./markdownlint": {
      "types": "./src/markdownlint.ts",
      "default": "./src/markdownlint.ts"
    }
  },
  "files": [
    "dist/",
    "MIGRATION.md"
  ],
  "scripts": {
    "build": "pnpm run typecheck && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf node_modules dist *.tsbuildinfo",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@commitlint/config-conventional": "^19.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-perfectionist": "^5.6.0",
    "globals": "^17.4.0",
    "typescript-eslint": "^8.56.1"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./commitlint": {
        "types": "./dist/commitlint.d.ts",
        "default": "./dist/commitlint.js"
      },
      "./markdownlint": {
        "types": "./dist/markdownlint.d.ts",
        "default": "./dist/markdownlint.js"
      }
    }
  },
  "devDependencies": {
    "@commitlint/types": "^19.0.0",
    "@tsconfig/node-ts": "^23.0.0",
    "@tsconfig/node24": "^24.0.0",
    "markdownlint": "^0.40.0",
    "typescript": "^5.9.3"
  }
}
