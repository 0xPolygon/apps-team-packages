{
  "name": "@polygonlabs/logger",
  "version": "3.0.0",
  "description": "Pino-based logger with Sentry integration, configured for Datadog ingestion and prettified output capable.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xPolygon/apps-team-packages.git",
    "directory": "packages/logger"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "exports": {
    ".": {
      "@polygonlabs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "MIGRATION.md"
  ],
  "scripts": {
    "build": "pnpm run typecheck && tsc -b tsconfig.lib.json",
    "build:clean": "pnpm run typecheck && rm -rf dist out-tsc *.tsbuildinfo && tsc -b tsconfig.lib.json",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint .",
    "clean": "rm -rf node_modules dist out-tsc *.tsbuildinfo",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@tsconfig/node-ts": "^23.0.0",
    "@tsconfig/node24": "^24.0.0",
    "@types/node": "^24.0.0",
    "@polygonlabs/verror": "workspace:*",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.3"
  },
  "peerDependencies": {
    "@polygonlabs/verror": ">=1.1.0",
    "@sentry/node": ">=8.0.0",
    "pino-pretty": ">=13.0.0"
  },
  "peerDependenciesMeta": {
    "@polygonlabs/verror": {
      "optional": false
    },
    "@sentry/node": {
      "optional": true
    },
    "pino-pretty": {
      "optional": true
    }
  }
}
