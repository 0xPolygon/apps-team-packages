{
  "name": "@polygonlabs/logger",
  "version": "0.3.0",
  "description": "Pino-based logger with Sentry integration, configured for Datadog ingestion and prettified output capable.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xPolygon/apps-team-packages.git",
    "directory": "packages/logger"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "clean": "rm -rf node_modules dist *.tsbuildinfo",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "pino": "^10.3.1",
    "@polygonlabs/verror": "workspace:*"
  },
  "devDependencies": {
    "@tsconfig/node-ts": "^23.0.0",
    "@tsconfig/node24": "^24.0.0",
    "@types/node": "^24.0.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.3"
  },
  "peerDependencies": {
    "@sentry/node": ">=8.0.0",
    "pino-pretty": ">=13.0.0"
  },
  "peerDependenciesMeta": {
    "@sentry/node": {
      "optional": true
    },
    "pino-pretty": {
      "optional": true
    }
  }
}
