{
  "name": "apps-team-packages",
  "version": "1.0.0",
  "description": "Polygon Apps Team shared packages monorepo",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/0xPolygon/apps-team-packages.git"
  },
  "scripts": {
    "prepare": "husky",
    "ci:publish": "pnpm run build && pnpm exec changeset publish",
    "clean": "pnpm -r run clean && rm -rf node_modules",
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "codegen-drift-check": "pnpm -r --if-present run codegen-drift",
    "lint": "concurrently --group --prefix-colors auto 'pnpm:lint:md' 'pnpm:lint:ts' 'pnpm:typecheck' 'prettier --check .'",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:ts": "eslint .",
    "format": "pnpm run format:md && pnpm run format:ts && prettier --write .",
    "format:md": "markdownlint-cli2 --fix \"**/*.md\"",
    "format:ts": "eslint . --fix"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.30.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@polygonlabs/apps-team-lint": "workspace:*",
    "@tsconfig/node-ts": "^23.0.0",
    "@tsconfig/node24": "^24.0.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "husky": "^9.0.0",
    "lint-staged": "^16.2.7",
    "markdownlint-cli2": "^0.22.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.3"
  }
}
